# ── Core ────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-32-random-bytes-hex
DATABASE_URL=postgresql+asyncpg://financebuddy:financebuddy@localhost:5432/financebuddy
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173","tauri://localhost","http://tauri.localhost"]

# Server-side envelope encryption key (hex 32 bytes). Rotate via KMS in prod.
DATA_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# ── LLM providers (fallback order; any subset) ─────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=claude-3-5-haiku-latest
LLM_LOCAL_MODEL=llama3.1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Bank aggregation ────────────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                      # sandbox|development|production
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
GOCARDLESS_ENV=sandbox                 # sandbox|production
BASIQ_API_KEY=
BASIQ_ENV=sandbox

FX_API_BASE=https://open.er-api.com/v6/latest

# ── OAuth social providers (optional) ──────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Observability (all optional) ────────────────────────────────────────
LANGCHAIN_TRACING_V2=false             # LangSmith
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
PHOENIX_ENDPOINT=http://localhost:6006
OPIK_API_KEY=
COMET_PROJECT_NAME=financebuddy

# ── OCR ────────────────────────────────────────────────────────────────
TESSERACT_CMD=                          # e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
