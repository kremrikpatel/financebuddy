# ── FinanceBuddy DEMO environment ───────────────────────────────────────
# Used only by docker-compose.demo.yml (start-demo.ps1 / start-demo.sh copies this to .env.demo).
# Everything here is throw-away: its own database (financebuddy_demo), its own Redis, and a
# seeded demo account  demo@financebuddy.app / DemoPass123!
# Never point this file at real data, and never use these values in production.

APP_ENV=demo
SECRET_KEY=demo-only-secret-key-not-for-production-0123456789
DATA_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
CORS_ORIGINS=["http://localhost:5173"]

# Demo database + cache (separate container, volume and ports from production and local dev)
POSTGRES_USER=financebuddy_demo
POSTGRES_PASSWORD=financebuddy_demo
POSTGRES_DB=financebuddy_demo
DEMO_DB_PORT=5433
DEMO_REDIS_PORT=6380

# Optional: add an LLM key to try the AI coach with a real model (otherwise built-in rules answer).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=claude-3-5-haiku-latest

# Bank aggregators stay in sandbox for the demo.
PLAID_ENV=sandbox
GOCARDLESS_ENV=sandbox
BASIQ_ENV=sandbox
