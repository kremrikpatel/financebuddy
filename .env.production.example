# ── FinanceBuddy PRODUCTION environment ─────────────────────────────────
# Used only by docker-compose.prod.yml. start-prod.ps1 / start-prod.sh copies this to
# .env.production on first run and generates every value marked GENERATE_ME.
#
#   * Back up .env.production somewhere safe. Losing DATA_ENCRYPTION_KEY makes encrypted
#     user data unreadable; losing POSTGRES_PASSWORD locks you out of the database.
#   * Fill in every CHANGE_ME before starting. The script and the API both refuse to start
#     with placeholders or development defaults.
#   * No demo user is ever created here; the first account is whoever signs up.

APP_ENV=production

# Generated by the start script (64 hex chars each). Do not reuse the demo/dev values.
SECRET_KEY=GENERATE_ME
DATA_ENCRYPTION_KEY=GENERATE_ME

# Production database + cache: own containers and volumes; not published on host ports.
POSTGRES_USER=financebuddy
POSTGRES_DB=financebuddy
POSTGRES_PASSWORD=GENERATE_ME
REDIS_PASSWORD=GENERATE_ME

# Public URLs the browser uses (put TLS / a reverse proxy in front of these ports).
# e.g. PUBLIC_API_URL=https://api.example.com/api/v1  and  CORS_ORIGINS=["https://app.example.com"]
PUBLIC_API_URL=CHANGE_ME
CORS_ORIGINS=CHANGE_ME
API_PORT=8000
WEB_PORT=5173

# ── LLM providers (at least one recommended; otherwise built-in rules answer) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=claude-3-5-haiku-latest
LLM_LOCAL_MODEL=llama3.1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Bank aggregation (switch to production environments with live credentials) ──
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
GOCARDLESS_ENV=production
BASIQ_API_KEY=
BASIQ_ENV=production
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

FX_API_BASE=https://open.er-api.com/v6/latest

# ── OAuth (optional) ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Observability (optional) ──
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OPIK_API_KEY=
COMET_PROJECT_NAME=financebuddy
